generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
  TAILOR
  CUTTING
  EMBROIDERY
  CASHIER
}

enum OrderStatus {
  // === APPROVAL & REJECTION ===
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CHANGES_REQUIRED

  // === PRICE CONFIRMATION ===
  WAITING_CUSTOMER_APPROVAL
  PRICE_SET
  CUSTOMER_APPROVED
  PRICE_REVISION_REQUIRED
  PRICE_DECLINED

  // === LEGACY (preserved for data safety) ===
  PENDING // old default — maps to ORDER_CONFIRMED in UI
  EMBROIDERY_AARI // old name — maps to AARI_EMBROIDERY in UI

  // === FULL PRODUCTION WORKFLOW ===
  ORDER_CONFIRMED
  PENDING_PRODUCTION
  TAILOR_ASSIGNED
  IN_PROGRESS
  CUTTING
  STITCHING
  AARI_EMBROIDERY
  QUALITY_CHECK
  ALTERATION
  FITTING_ALTERATION
  FINISHING
  READY
  DELIVERED
  COMPLETED
  ON_HOLD
  CANCELLED
}

model User {
  id                         Int                      @id @default(autoincrement())
  name                       String
  email                      String                   @unique
  password                   String
  role                       Role                     @default(STAFF)
  branchId                   Int?
  branch                     Branch?                  @relation(fields: [branchId], references: [id])
  isActive                   Boolean                  @default(true)
  lastLoginAt                DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  productionHistory          ProductionHistory[]
  assignedOrders             Order[]                  @relation("TailorAssignedOrders")
  attendances                Attendance[]
  stockMovements             StockMovement[]
  materialRequestsAsTailor   OrderMaterialRequest[]   @relation("TailorMaterialRequests")
  employee                   Employee?
  resetTokens                PasswordResetToken[]
  assignedTasks              OrderTask[]              @relation("TailorTasks")
  receivedCustomerFabrics    CustomerFabric[]         @relation("CustomerFabricReceiver")
  tailorCustomerMovements    CustomerFabricMovement[] @relation("CustomerFabricTailor")
  performedCustomerMovements CustomerFabricMovement[] @relation("CustomerFabricPerformer")
  performanceProfile         PerformanceProfile?      @relation("UserPerformanceProfile")
  approvedReviews            PerformanceReview[]      @relation("FounderReviewApprovals")
  submittedEvidence          PerformanceEvidence[]    @relation("EvidenceSubmitter")
  verifiedEvidence           PerformanceEvidence[]    @relation("EvidenceVerifier")
  performanceAuditLogs       PerformanceAuditLog[]    @relation("PerformanceAuditor")
  financialTransactionsCreated  FinancialTransaction[] @relation("FinancialTransactionCreator")
  financialTransactionsApproved FinancialTransaction[] @relation("FinancialTransactionApprover")
  salaryAdvancesRequested       SalaryAdvance[]        @relation("SalaryAdvanceRequester")
  salaryAdvancesApproved        SalaryAdvance[]        @relation("SalaryAdvanceApprover")
  employeeSalariesApproved      EmployeeSalary[]       @relation("EmployeeSalaryApprover")
  employeeSalariesPaid          EmployeeSalary[]       @relation("EmployeeSalaryPayer")
  financialAuditLogs            FinancialAuditLog[]    @relation("FinancialAuditActor")
  expensesCreated               BusinessExpense[]      @relation("ExpenseCreator")
  expensesApproved              BusinessExpense[]      @relation("ExpenseApprover")
  expensePaymentsCreated        ExpensePaymentHistory[] @relation("ExpensePaymentCreator")
}

model Branch {
  id                      Int                      @id @default(autoincrement())
  name                    String
  address                 String?
  phone                   String?
  manager                 String?
  status                  String                   @default("ACTIVE")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  users                   User[]
  employees               Employee[]
  orders                  Order[]
  inventoryItems          InventoryItem[]
  purchaseOrders          PurchaseOrder[]
  orderTasks              OrderTask[]
  customerFabrics         CustomerFabric[]
  customerFabricMovements CustomerFabricMovement[]
  financialAccounts       FinancialAccount[]
  financialTransactions   FinancialTransaction[]
  employeeSalaries        EmployeeSalary[]
  salaryAdvances          SalaryAdvance[]
  monthlyBills            MonthlyBill[]
  businessExpenses        BusinessExpense[]
}

model Customer {
  id               Int                   @id @default(autoincrement())
  name             String
  primaryPhone     String                @unique
  alternativePhone String?
  email            String?               @unique
  password         String?
  address          String?
  profilePhoto     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  orders           Order[]
  measurements     CustomerMeasurement[]
  customerFabrics  CustomerFabric[]
}

model Order {
  id              Int             @id @default(autoincrement())
  orderNumber     String          @unique
  orderDate       DateTime        @default(now())
  customerId      Int
  customer        Customer        @relation(fields: [customerId], references: [id])
  branchId        Int?
  branch          Branch?         @relation(fields: [branchId], references: [id])
  previousOrderId Int?
  previousOrder   Order?          @relation("PreviousOrder", fields: [previousOrderId], references: [id])
  nextOrders      Order[]         @relation("PreviousOrder")
  garmentDetails  GarmentDetails?
  orderSource     String          @default("SHOP") // "SHOP" or "ONLINE"
  status          OrderStatus     @default(ORDER_CONFIRMED)
  totalAmount     Float           @default(0)
  advancePayment  Float           @default(0)
  balanceAmount   Float           @default(0)

  // Pricing breakdown & Customer confirmation
  basePrice               Float?    @default(0)
  designCharge            Float?    @default(0)
  cuttingCharge           Float?    @default(0)
  stitchingCharge         Float?    @default(0)
  embroideryCharge        Float?    @default(0)
  additionalCharge        Float?    @default(0)
  serviceCharge           Float     @default(0)
  additionalWorkCharge    Float     @default(0)
  materialCharge          Float     @default(0)
  discountAmount          Float     @default(0)
  priceStatus             String    @default("PENDING") // PENDING, SENT, ACCEPTED, DECLINED
  priceSetBy              String?
  priceSetAt              DateTime?
  priceSentAt             DateTime?
  priceAcceptedByCustomer Boolean   @default(false)
  priceAcceptedAt         DateTime?
  priceDeclinedAt         DateTime?
  priceDeclineReason      String?
  agreedTotal             Float?
  agreedAdvance           Float?
  agreedBalance           Float?
  advanceRequired         Float?    @default(0)
  paymentStatus           String    @default("Unpaid")
  payments                Payment[]

  // Approval workflow
  approvedBy         String?
  approvedAt         DateTime?
  rejectedBy         String?
  rejectedAt         DateTime?
  rejectionReason    String?
  changesRequestedBy String?
  changesRequestedAt DateTime?
  changesReason      String?
  customerApprovedAt DateTime?
  revisionReason     String?

  // Delivery & Completion
  deliveredBy   String?
  deliveredAt   DateTime?
  deliveryNotes String?
  completedBy   String?
  completedAt   DateTime?

  // Tailor assignment (ONE ORDER = ONE TAILOR)
  assignedTailorId      Int?
  assignedTailor        User?     @relation("TailorAssignedOrders", fields: [assignedTailorId], references: [id])
  assignedBy            String?
  assignedAt            DateTime?
  tailorAccepted        Boolean   @default(false)
  tailorAcceptedAt      DateTime?
  tailorRejectedAt      DateTime?
  tailorRejectionReason String?

  // Notification Tracking
  readyNotificationSent   Boolean?  @default(false)
  readyNotificationSentAt DateTime?
  readyNotificationSentBy String?
  readyNotificationStatus String?

  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  productionHistory ProductionHistory[]
  materialRequests  OrderMaterialRequest[]
  stockMovements    StockMovement[]
  tasks             OrderTask[]
  customerFabrics   CustomerFabric[]
}

model GarmentDetails {
  id                        Int      @id @default(autoincrement())
  orderId                   Int      @unique
  order                     Order    @relation(fields: [orderId], references: [id])
  dressType                 String
  quantity                  Int
  occasion                  String?
  fabricSuppliedBy          String?
  fabricType                String?
  fabricColour              String?
  liningRequired            Boolean  @default(false)
  paddingCupRequired        Boolean  @default(false)
  workRequired              Boolean  @default(false)
  workDetails               String?
  accessoriesSupplied       String?
  specialDesignInstructions String?
  designReferenceImage      String?
  measurements              Json?
  measurementUnit           String?  @default("Inches")
  fitPreference             String?
  additionalImages          Json?
  customerMeasurementId     Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model CustomerMeasurement {
  id                  Int      @id @default(autoincrement())
  customerId          Int
  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId             Int?
  dressType           String
  measurementUnit     String   @default("Inches")
  fitPreference       String   @default("Regular")
  takenBy             String   @default("Customer")
  measurementDate     DateTime @default(now())
  measurements        Json
  fittingInstructions String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([customerId, dressType])
}

model ProductionHistory {
  id            Int          @id @default(autoincrement())
  orderId       Int
  order         Order        @relation(fields: [orderId], references: [id])
  stage         OrderStatus
  previousStage OrderStatus?
  nextStage     OrderStatus?
  assignedToId  Int?
  assignedTo    User?        @relation(fields: [assignedToId], references: [id])
  notes         String?
  startedAt     DateTime     @default(now())
  completedAt   DateTime?
  durationMins  Int?
  createdAt     DateTime     @default(now())
}

model Payment {
  id              Int       @id @default(autoincrement())
  orderId         Int
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount          Float
  paymentMethod   String?   @default("Cash")
  notes           String?
  recordedBy      String?
  slipImage       String?
  status          String?   @default("VERIFIED") // PENDING_VERIFICATION, VERIFIED, REJECTED
  transactionRef  String?
  verifiedBy      String?
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderId])
}

model Attendance {
  id        Int       @id @default(autoincrement())
  userId    Int?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tailorId  Int?
  date      String // YYYY-MM-DD
  status    String // Present, Checked Out, Absent, Not Marked
  checkIn   DateTime?
  checkOut  DateTime?
  role      String?
  branch    String?
  markedBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([tailorId])
  @@index([date])
}

model CustomerOtp {
  id         Int      @id @default(autoincrement())
  identifier String   @unique
  otpHash    String
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// =====================================================================
// INVENTORY & MATERIAL MANAGEMENT (created by scripts/apply_inventory_schema.js)
// Stock is valued with the Weighted Average Cost (WAC) method.
// DB-level CHECK constraints (non-negative stock, valid quantities) are
// defined in the migration script; Prisma does not model CHECK constraints.
// =====================================================================

model Supplier {
  id             Int             @id @default(autoincrement())
  code           String          @unique
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  category       String?
  paymentTerms   String?
  taxId          String?
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  items          InventoryItem[]
  purchaseOrders PurchaseOrder[]
}

model InventoryItem {
  id               Int                    @id @default(autoincrement())
  sku              String                 @unique
  name             String
  category         String
  description      String?
  unit             String
  colour           String?
  openingStock     Float                  @default(0)
  currentStock     Float                  @default(0)
  minStockLevel    Float                  @default(0)
  reorderLevel     Float                  @default(0)
  unitCost         Float                  @default(0)
  storageLocation  String?
  supplierId       Int?
  supplier         Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  branchId         Int?
  branch           Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive         Boolean                @default(true)
  createdById      Int?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @default(now()) @updatedAt
  movements        StockMovement[]
  materialRequests OrderMaterialRequest[]
  poItems          PurchaseOrderItem[]

  @@index([category])
  @@index([branchId])
  @@index([supplierId])
}

model OrderMaterialRequest {
  id              Int           @id @default(autoincrement())
  requestNo       String        @unique
  orderId         Int
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderNumber     String
  itemId          Int
  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  requestedQty    Float
  issuedQty       Float         @default(0)
  returnedQty     Float         @default(0)
  wastageQty      Float         @default(0)
  consumedQty     Float         @default(0)
  status          String        @default("REQUESTED") // REQUESTED, PARTIALLY_ISSUED, ISSUED, COMPLETED, REJECTED, CANCELLED
  requestedById   Int?
  requestedByName String?
  issuedById      Int?
  issuedByName    String?
  issuedAt        DateTime?
  branchId        Int?
  tailorId        Int?
  tailor          User?         @relation("TailorMaterialRequests", fields: [tailorId], references: [id], onDelete: SetNull)
  tailorName      String?
  damagedQty      Float         @default(0)
  notes           String?
  rejectionReason String?
  clientKey       String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  @@index([orderId])
  @@index([itemId])
  @@index([tailorId])
  @@index([status])
}

model PurchaseOrder {
  id              Int                 @id @default(autoincrement())
  poNumber        String              @unique
  supplierId      Int
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branchId        Int?
  branch          Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  status          String              @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, PARTIALLY_RECEIVED, RECEIVED, REJECTED, CANCELLED
  totalAmount     Float               @default(0)
  expectedDate    DateTime?
  notes           String?
  requestedById   Int?
  requestedByName String?
  approvedById    Int?
  approvedByName  String?
  approvedAt      DateTime?
  rejectedByName  String?
  rejectionReason String?
  clientKey       String?             @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt
  items           PurchaseOrderItem[]
  receipts        GoodsReceipt[]

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id               Int           @id @default(autoincrement())
  purchaseOrderId  Int
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId           Int
  item             InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantityOrdered  Float
  quantityReceived Float         @default(0)
  unitCost         Float         @default(0)

  @@index([purchaseOrderId])
  @@index([itemId])
}

model GoodsReceipt {
  id                Int           @id @default(autoincrement())
  grnNumber         String        @unique
  purchaseOrderId   Int
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplierInvoiceNo String?
  invoiceAmount     Float?
  lines             Json
  notes             String?
  receivedById      Int?
  receivedByName    String?
  clientKey         String?       @unique
  createdAt         DateTime      @default(now())

  @@index([purchaseOrderId])
}

model StockMovement {
  id                Int           @id @default(autoincrement())
  itemId            Int
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  type              String // OPENING, STOCK_IN, GRN_RECEIPT, ISSUE, ORDER_ISSUE, ORDER_RETURN, RETURN, WASTAGE, DAMAGED, ADJUSTMENT
  quantity          Float // signed: + into stock, - out of stock
  unitCost          Float         @default(0)
  previousStock     Float
  newStock          Float
  referenceNo       String?
  reason            String?
  orderId           Int?
  order             Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderNumber       String?
  materialRequestId Int?
  purchaseOrderId   Int?
  branchId          Int?
  performedById     Int?
  performedBy       User?         @relation(fields: [performedById], references: [id], onDelete: SetNull)
  performedByName   String?
  idempotencyKey    String?       @unique
  createdAt         DateTime      @default(now())

  @@index([itemId, createdAt])
  @@index([type])
  @@index([orderId])
  @@index([createdAt])
}

model InventoryAuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   Int?
  userId     Int?
  userName   String?
  userRole   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Employee {
  id         Int      @id @default(autoincrement())
  employeeId String   @unique
  name       String
  email      String?
  phone      String?
  role       String
  branchId   Int?
  branch     Branch?  @relation(fields: [branchId], references: [id])
  userId     Int?     @unique
  user       User?    @relation(fields: [userId], references: [id])
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  salaries   EmployeeSalary[]
  salaryAdvances SalaryAdvance[]

  @@index([branchId])
  @@index([role])
}

model PasswordResetToken {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String
  expiresAt   DateTime
  usedAt      DateTime?
  isUsed      Boolean   @default(false)
  requestedBy String?
  createdAt   DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   Int?
  userId     Int?
  userName   String?
  userRole   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model OrderTask {
  id               Int       @id @default(autoincrement())
  orderId          Int
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  taskType         String // CUTTING, STITCHING, AARI_EMBROIDERY, FITTING_ALTERATION, FINISHING, QUALITY_CHECK
  taskName         String // "Cutting", "Stitching", "Aari Embroidery", "Fitting / Alteration", "Finishing", "Quality Check"
  assignedTailorId Int?
  assignedTailor   User?     @relation("TailorTasks", fields: [assignedTailorId], references: [id], onDelete: SetNull)
  assignedById     Int?
  assignedBy       String?
  assignedAt       DateTime? @default(now())
  status           String    @default("ASSIGNED") // ASSIGNED, IN_PROGRESS, COMPLETED, CANCELLED
  startedAt        DateTime?
  completedAt      DateTime?
  notes            String?
  sequence         Int       @default(1)
  branchId         Int?
  branch           Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([orderId])
  @@index([assignedTailorId])
  @@index([status])
  @@index([branchId])
}

model CustomerFabric {
  id                         Int                      @id @default(autoincrement())
  code                       String                   @unique
  customerId                 Int
  customer                   Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName               String
  customerPhone              String?
  orderId                    Int
  order                      Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderNumber                String
  fabricType                 String
  fabricColour               String
  fabricDescription          String?
  receivedQty                Float
  availableQty               Float
  issuedQty                  Float                    @default(0)
  tailorBalanceQty           Float                    @default(0)
  consumedQty                Float                    @default(0)
  returnedToStoreQty         Float                    @default(0)
  returnedToCustomerQty      Float                    @default(0)
  wasteQty                   Float                    @default(0)
  unit                       String                   @default("Meters")
  dateReceived               DateTime                 @default(now())
  conditionNotes             String?
  branchId                   Int?
  branch                     Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchName                 String?
  receivedById               Int?
  receivedBy                 User?                    @relation("CustomerFabricReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  receivedByName             String?
  status                     String                   @default("AVAILABLE")
  customerPurchasePrice      Float?
  customerPurchaseCurrency   String?                  @default("LKR")
  customerPurchasePriceType  String?                  @default("TOTAL") // "TOTAL" or "PER_UNIT"
  customerPurchaseReceiptUrl String?
  photoUrl                   String?
  materialCategory           String?                  @default("Fabric")
  materialName               String?
  conditionOnReceipt         String?                  @default("Good")
  notes                      String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @default(now()) @updatedAt
  movements                  CustomerFabricMovement[]

  @@index([customerId])
  @@index([orderId])
  @@index([orderNumber])
  @@index([branchId])
  @@index([fabricType])
  @@index([status])
  @@index([createdAt])
}

model CustomerFabricMovement {
  id                   Int            @id @default(autoincrement())
  customerFabricId     Int
  customerFabric       CustomerFabric @relation(fields: [customerFabricId], references: [id], onDelete: Cascade)
  movementType         String
  quantity             Float
  previousAvailableQty Float
  newAvailableQty      Float
  previousTailorQty    Float
  newTailorQty         Float
  tailorId             Int?
  tailor               User?          @relation("CustomerFabricTailor", fields: [tailorId], references: [id], onDelete: SetNull)
  tailorName           String?
  notes                String?
  branchId             Int?
  branch               Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  performedById        Int?
  performedBy          User?          @relation("CustomerFabricPerformer", fields: [performedById], references: [id], onDelete: SetNull)
  performedByName      String?
  performedByRole      String?
  idempotencyKey       String?        @unique
  createdAt            DateTime       @default(now())

  @@index([customerFabricId])
  @@index([movementType])
  @@index([tailorId])
  @@index([createdAt])
}

// =====================================================================
// MANAGEMENT PERFORMANCE & ACCOUNTABILITY (MPA) MODULE
// JB GROUP (PVT) LTD — Version 3.2.0
// Isolated models for executive evaluation, evidence tracking, and review.
// =====================================================================

model PerformanceProfile {
  id             Int                   @id @default(autoincrement())
  userId         Int                   @unique
  user           User                  @relation("UserPerformanceProfile", fields: [userId], references: [id], onDelete: Restrict)
  officerName    String
  position       String
  company        String                @default("JB GROUP (PVT) LTD")
  maxWeeklyScore Float                 @default(100.0)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  criteria       PerformanceCriteria[]
  reviews        PerformanceReview[]
  evidence       PerformanceEvidence[]

  @@index([userId])
}

model PerformanceCriteria {
  id            Int                   @id @default(autoincrement())
  profileId     Int
  profile       PerformanceProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  code          String
  name          String
  maxPoints     Float
  scoringMethod String                @default("AUTOMATED") // AUTOMATED, QUALITATIVE_REVIEW, HYBRID
  targetType    String? // REVENUE_LKR, ORDER_COUNT, ATTENDANCE_PERCENT, REPORT_COUNT, ACCURACY_PERCENT
  defaultTarget Float?
  unit          String? // LKR, %, orders, tasks, reports
  orderIndex    Int                   @default(1)
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  scores        PerformanceScore[]
  evidence      PerformanceEvidence[]

  @@unique([profileId, code])
  @@unique([id, profileId])
  @@index([profileId])
}

model PerformanceReview {
  id                Int                   @id @default(autoincrement())
  profileId         Int
  profile           PerformanceProfile    @relation(fields: [profileId], references: [id], onDelete: Restrict)
  weekNumber        Int
  year              Int
  weekStartDate     DateTime
  weekEndDate       DateTime
  totalScore        Float                 @default(0.0)
  performanceRating String                @default("PENDING_VERIFICATION") // EXCELLENT (90-100), GOOD (75-89.99), NEEDS_IMPROVEMENT (60-74.99), UNSATISFACTORY (<60), PENDING_VERIFICATION
  status            String                @default("DRAFT") // DRAFT, SUBMITTED, PENDING_FOUNDER_APPROVAL, APPROVED, RETURNED_FOR_CORRECTION
  isLocked          Boolean               @default(false)
  submittedAt       DateTime?
  approvedById      Int?
  approvedBy        User?                 @relation("FounderReviewApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  founderNotes      String?
  returnReason      String?
  version           Int                   @default(1)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  scores            PerformanceScore[]
  auditLogs         PerformanceAuditLog[]

  @@unique([profileId, year, weekNumber])
  @@unique([id, profileId])
  @@index([profileId])
  @@index([status])
  @@index([weekStartDate, weekEndDate])
}

model PerformanceScore {
  id                 Int                   @id @default(autoincrement())
  profileId          Int
  reviewId           Int
  review             PerformanceReview     @relation(fields: [reviewId, profileId], references: [id, profileId], onDelete: Cascade)
  criteriaId         Int
  criteria           PerformanceCriteria   @relation(fields: [criteriaId, profileId], references: [id, profileId], onDelete: Restrict)
  maxPoints          Float
  targetMetric       Float?
  actualMetric       Float?
  calculatedPoints   Float                 @default(0.0)
  manualAdjustment   Float                 @default(0.0)
  finalPoints        Float                 @default(0.0)
  verificationStatus String                @default("PENDING_REVIEW") // VERIFIED, PENDING_REVIEW, NOT_VERIFIED, REJECTED
  notes              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  evidence           PerformanceEvidence[]

  @@unique([reviewId, criteriaId])
  @@unique([id, profileId])
  @@index([reviewId])
  @@index([criteriaId])
  @@index([profileId])
}

model PerformanceEvidence {
  id                 Int                 @id @default(autoincrement())
  profileId          Int
  profile            PerformanceProfile  @relation(fields: [profileId], references: [id], onDelete: Restrict)
  criteriaId         Int
  criteria           PerformanceCriteria @relation(fields: [criteriaId, profileId], references: [id, profileId], onDelete: Restrict)
  scoreId            Int?
  score              PerformanceScore?   @relation(fields: [scoreId, profileId], references: [id, profileId], onDelete: Restrict)
  activityDate       DateTime
  description        String
  evidenceType       String // ERP_PAYMENT, ERP_ORDER, ERP_ATTENDANCE, DAILY_REPORT, DOCUMENT, NOTE
  erpReferenceType   String? // PAYMENT, ORDER, ATTENDANCE, TASK, AUDIT
  erpReferenceId     Int?
  erpReferenceNumber String?
  documentUrl        String?
  submittedById      Int
  submittedBy        User                @relation("EvidenceSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  verificationStatus String              @default("PENDING") // PENDING, VERIFIED, REJECTED, NOT_VERIFIED
  verifiedById       Int?
  verifiedBy         User?               @relation("EvidenceVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt         DateTime?
  verificationNotes  String?
  deduplicationKey   String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([profileId])
  @@index([criteriaId])
  @@index([activityDate])
  @@index([verificationStatus])
}

model PerformanceAuditLog {
  id              Int                @id @default(autoincrement())
  reviewId        Int?
  review          PerformanceReview? @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  action          String // SCORE_CALCULATED, EVIDENCE_SUBMITTED, EVIDENCE_VERIFIED, MANUAL_ADJUSTMENT, REVIEW_SUBMITTED, REVIEW_APPROVED, REVIEW_RETURNED, TARGET_UPDATED
  performedById   Int
  performedBy     User               @relation("PerformanceAuditor", fields: [performedById], references: [id], onDelete: Restrict)
  performedByName String?
  performedByRole String?
  previousValue   Json?
  newValue        Json?
  reason          String?
  ipAddress       String?
  createdAt       DateTime           @default(now())

  @@index([reviewId])
  @@index([performedById])
  @@index([action])
  @@index([createdAt])
}

// =====================================================================
// FINANCIAL ACCOUNTING & BUSINESS CONTROL MODULE
// JB GROUP (PVT) LTD — Version 3.2.0
// Isolated models for cash drawers, bank accounts, general ledger,
// employee payroll, salary advances, reconciliation, and audit trail.
// =====================================================================

model FinancialAccount {
  id                Int                    @id @default(autoincrement())
  branchId          Int?
  branch            Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  accountType       String                 // CASH, BANK, PETTY_CASH
  accountName       String
  accountNumber     String?
  bankName          String?
  bankBranch        String?
  currency          String                 @default("LKR")
  openingBalance    Decimal                @default(0) @db.Decimal(12, 2)
  currentBalance    Decimal                @default(0) @db.Decimal(12, 2)
  status            String                 @default("ACTIVE") // ACTIVE, INACTIVE, FROZEN
  isPrimary         Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  transactions      FinancialTransaction[] @relation("AccountTransactions")
  transfersIn       FinancialTransaction[] @relation("TransferDestinationAccount")
  reconciliations   BankReconciliation[]
  disbursedSalaries EmployeeSalary[]
  disbursedAdvances SalaryAdvance[]
  billsPaid         MonthlyBill[]
  expensePayments   ExpensePaymentHistory[]

  @@index([branchId])
  @@index([accountType])
  @@index([status])
}

model AccountingCategory {
  id               Int                    @id @default(autoincrement())
  categoryType     String                 // INCOME, EXPENSE, TRANSFER, ASSET, LIABILITY
  code             String                 @unique
  name             String
  description      String?
  parentCategoryId Int?
  parentCategory   AccountingCategory?    @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  subCategories    AccountingCategory[]   @relation("CategoryHierarchy")
  isSystem         Boolean                @default(false)
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  transactions     FinancialTransaction[]

  @@index([categoryType])
  @@index([isActive])
}

model FinancialTransaction {
  id                Int                 @id @default(autoincrement())
  transactionNumber String              @unique
  transactionDate   DateTime            @default(now())
  branchId          Int
  branch            Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type              String              // INCOME, EXPENSE, TRANSFER_OUT, TRANSFER_IN
  categoryId        Int
  category          AccountingCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  accountId         Int
  account           FinancialAccount    @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Restrict)
  toAccountId       Int?
  toAccount         FinancialAccount?   @relation("TransferDestinationAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  amount            Decimal             @db.Decimal(12, 2)
  paymentMethod     String              @default("CASH") // CASH, BANK_TRANSFER, CHEQUE, CREDIT_CARD, ONLINE
  referenceNo       String?
  description       String?
  notes             String?
  receiptImage      String?
  approvalStatus    String              @default("APPROVED") // PENDING_APPROVAL, APPROVED, REJECTED, REVERSED
  approvedById      Int?
  approvedBy        User?               @relation("FinancialTransactionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedByName    String?
  approvedAt        DateTime?
  createdById       Int
  createdBy         User                @relation("FinancialTransactionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdByName     String
  isReversed        Boolean             @default(false)
  reversalOfId      Int?
  reversalReason    String?
  sourceModule      String?             // ORDER_PAYMENT, TAILOR_SALARY, STAFF_PAYROLL, PURCHASE_ORDER, SALARY_ADVANCE, MANUAL
  sourceRecordId    Int?
  expensePayments   ExpensePaymentHistory[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([sourceModule, sourceRecordId])
  @@index([branchId, transactionDate])
  @@index([categoryId])
  @@index([accountId])
  @@index([type])
  @@index([approvalStatus])
}

model EmployeeSalary {
  id                Int               @id @default(autoincrement())
  payrollNumber     String            @unique
  employeeId        Int
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  userId            Int?
  branchId          Int
  branch            Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  month             String            // YYYY-MM
  basicSalary       Decimal           @default(0) @db.Decimal(12, 2)
  allowances        Decimal           @default(0) @db.Decimal(12, 2)
  overtimeAmount    Decimal           @default(0) @db.Decimal(12, 2)
  grossSalary       Decimal           @default(0) @db.Decimal(12, 2)
  advanceDeductions Decimal           @default(0) @db.Decimal(12, 2)
  epfDeduction      Decimal           @default(0) @db.Decimal(12, 2)
  otherDeductions   Decimal           @default(0) @db.Decimal(12, 2)
  netSalary         Decimal           @default(0) @db.Decimal(12, 2)
  status            String            @default("DRAFT") // DRAFT, APPROVED, PAID, CANCELLED
  paymentDate       DateTime?
  paidFromAccountId Int?
  paidFromAccount   FinancialAccount? @relation(fields: [paidFromAccountId], references: [id], onDelete: SetNull)
  paymentMethod     String?           @default("CASH")
  approvedById      Int?
  approvedBy        User?             @relation("EmployeeSalaryApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  paidById          Int?
  paidBy            User?             @relation("EmployeeSalaryPayer", fields: [paidById], references: [id], onDelete: SetNull)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  advancesDeducted  SalaryAdvance[]

  @@unique([employeeId, month])
  @@index([branchId, month])
  @@index([status])
}

model SalaryAdvance {
  id                     Int               @id @default(autoincrement())
  advanceNumber          String            @unique
  employeeId             Int
  employee               Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  userId                 Int?
  user                   User?             @relation("SalaryAdvanceRequester", fields: [userId], references: [id], onDelete: SetNull)
  branchId               Int
  branch                 Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  amount                 Decimal           @db.Decimal(12, 2)
  advanceDate            DateTime          @default(now())
  reason                 String?
  status                 String            @default("PENDING") // PENDING, APPROVED, DISBURSED, REJECTED, DEDUCTED
  disbursedFromAccountId Int?
  disbursedFromAccount   FinancialAccount? @relation(fields: [disbursedFromAccountId], references: [id], onDelete: SetNull)
  disbursedAt            DateTime?
  approvedById           Int?
  approvedBy             User?             @relation("SalaryAdvanceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  deductedInSalaryId     Int?
  deductedInSalary       EmployeeSalary?   @relation(fields: [deductedInSalaryId], references: [id], onDelete: SetNull)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([employeeId])
  @@index([branchId])
  @@index([status])
}

model BankReconciliation {
  id               Int              @id @default(autoincrement())
  accountId        Int
  account          FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  statementDate    DateTime
  statementBalance Decimal          @db.Decimal(12, 2)
  ledgerBalance    Decimal          @db.Decimal(12, 2)
  difference       Decimal          @db.Decimal(12, 2)
  status           String           @default("BALANCED") // BALANCED, DISCREPANCY
  notes            String?
  reconciledById   Int
  createdAt        DateTime         @default(now())

  @@index([accountId])
  @@index([statementDate])
}

model FinancialAuditLog {
  id              Int      @id @default(autoincrement())
  action          String   // EXPENSE_CREATED, EXPENSE_APPROVED, PAYMENT_RECEIVED, SALARY_DISBURSED, ACCOUNT_ADJUSTED, TRANSACTION_REVERSED
  entityType      String   // TRANSACTION, ACCOUNT, PAYROLL, ADVANCE, RECONCILIATION
  entityId        Int
  amount          Decimal? @db.Decimal(12, 2)
  branchId        Int?
  performedById   Int
  performedBy     User     @relation("FinancialAuditActor", fields: [performedById], references: [id], onDelete: Restrict)
  performedByName String
  performedByRole String
  previousState   Json?
  newState        Json?
  ipAddress       String?
  reason          String?
  createdAt       DateTime @default(now())

  @@index([entityType, entityId])
  @@index([performedById])
  @@index([branchId])
  @@index([createdAt])
}

model MonthlyBill {
  id               Int               @id @default(autoincrement())
  billNumber       String            @unique
  billName         String
  category         String            // RENT, ELECTRICITY, WATER, INTERNET, TELEPHONE, SECURITY, MAINTENANCE, CLEANING, OTHER
  branchId         Int
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  providerName     String?
  expectedAmount   Decimal           @db.Decimal(12, 2)
  actualAmount     Decimal?          @db.Decimal(12, 2)
  paidAmount       Decimal           @default(0) @db.Decimal(12, 2)
  billReference    String?
  billingMonth     String            // YYYY-MM
  billDate         DateTime          @default(now())
  dueDate          DateTime
  status           String            @default("UNPAID") // UPCOMING, UNPAID, PARTIALLY_PAID, PAID, OVERDUE
  paymentMethod    String?           // CASH, BANK_TRANSFER, CHEQUE, ONLINE
  paymentAccountId Int?
  paymentAccount   FinancialAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  paymentDate      DateTime?
  receiptImage     String?
  notes            String?
  createdById      Int
  createdByName    String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([branchId, category, billingMonth], name: "MonthlyBill_branch_cat_month_key")
  @@index([branchId])
  @@index([billingMonth])
  @@index([status])
  @@index([dueDate])
}

model BusinessExpense {
  id               Int                     @id @default(autoincrement())
  expenseNumber    String                  @unique
  title            String
  category         String                  // SHOP_RENT, ELECTRICITY_BILL, WATER_BILL, INTERNET_BILL, TELEPHONE_BILL, STAFF_SALARY, TRANSPORT, OFFICE_EXPENSES, MAINTENANCE, REPAIR_EXPENSES, STAFF_WELFARE, PURCHASES, DELIVERY_EXPENSES, EMERGENCY_EXPENSES, OTHER_EXPENSES
  branchId         Int
  branch           Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  totalAmount      Decimal                 @default(0) @db.Decimal(12, 2)
  paidAmount       Decimal                 @default(0) @db.Decimal(12, 2)
  pendingAmount    Decimal                 @default(0) @db.Decimal(12, 2)
  dueDate          DateTime?
  expenseDate      DateTime                @default(now())
  paymentMethod    String?                 // CASH, BANK_TRANSFER, CHEQUE, CARD, ONLINE
  paidBy           String?
  paidTo           String?
  receiptImage     String?
  description      String?
  notes            String?
  status           String                  @default("PENDING") // PENDING, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  approvalStatus   String                  @default("APPROVED") // APPROVED, PENDING_APPROVAL, REJECTED
  approvedById     Int?
  approvedBy       User?                   @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedByName   String?
  createdById      Int
  createdBy        User                    @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdByName    String
  isRecurring      Boolean                 @default(false)
  billingMonth     String?                 // YYYY-MM
  previousBalance  Decimal                 @default(0) @db.Decimal(12, 2)
  expectedAmount   Decimal?                @db.Decimal(12, 2)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  payments         ExpensePaymentHistory[]

  @@index([branchId])
  @@index([category])
  @@index([status])
  @@index([dueDate])
  @@index([expenseDate])
  @@index([branchId, category, billingMonth])
}

model ExpensePaymentHistory {
  id            Int                  @id @default(autoincrement())
  expenseId     Int
  expense       BusinessExpense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  paymentNumber String               @unique
  amount        Decimal              @db.Decimal(12, 2)
  paymentDate   DateTime             @default(now())
  paymentMethod String               @default("CASH") // CASH, BANK_TRANSFER, CHEQUE, CARD, ONLINE
  accountId     Int?
  account       FinancialAccount?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  paidBy        String
  paidTo        String?
  receiptImage  String?
  notes         String?
  transactionId Int?
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdById   Int
  createdBy     User                 @relation("ExpensePaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime             @default(now())

  @@index([expenseId])
  @@index([paymentDate])
}

