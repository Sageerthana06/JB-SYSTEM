/**
 * Weekly Tailor Salary Calculation Engine — JB GROUP (PVT) LTD
 *
 * =========================================================================
 * 1. BUSINESS ALLOCATION RULES (50 / 25 / 25 SPLIT)
 * =========================================================================
 * Every approved order price is split into three fixed portions:
 *
 *   [ Agreed Order Total (100%) ]
 *             │
 *             ├──> 50%  Office / Company Overhead (Materials, rent, utilities, margin)
 *             ├──> 25%  Cutting Tailor Allocation (Patterning, fabric shearing)
 *             └──> 25%  Stitching Tailor Allocation (Seam assembly, lining, finishing)
 *
 * Example: Order for LKR 2,000
 * - Office:    LKR 1,000 (50%)
 * - Cutting:   LKR   500 (25%)
 * - Stitching: LKR   500 (25%)
 * Total:       LKR 2,000 (100%)
 *
 * =========================================================================
 * 2. SALARY ALLOCATION LIFECYCLE STATE MACHINE
 * =========================================================================
 * An allocation transitions through 4 clear states:
 *
 *   [ WORK_PENDING ]
 *          │  (Tailor completes cutting or stitching work)
 *          ▼
 *   [ ON_HOLD_CUSTOMER_PAYMENT ]
 *          │  (Customer settles their order invoice in full)
 *          ▼
 *   [ PAYABLE ]
 *          │  (Authorized Manager/CEO records salary disbursement)
 *          ▼
 *   [ PAID ]
 *
 * Key Business Rule:
 * Tailors earn their allocation only when work is completed.
 * The salary becomes PAYABLE only when work is complete AND customer has paid in full.
 *
 * =========================================================================
 * 3. ASIA/COLOMBO TIMEZONE MECHANICS (UTC +05:30)
 * =========================================================================
 * Sri Lanka does not use Daylight Saving Time (DST). The local time is always
 * UTC + 5 hours 30 minutes (330 minutes).
 * A business week runs from Monday 00:00:00.000 to Sunday 23:59:59.999 local time.
 */

// Timezone offset for Asia/Colombo: UTC + 05:30 in minutes (330 minutes = 19,800,000 ms)
const COLOMBO_OFFSET_MINUTES = 330;

/**
 * Converts any UTC Date or ISO string into local Asia/Colombo calendar components.
 *
 * Why this is needed:
 * In a standard Node.js environment, `new Date()` runs in the server's local timezone (or UTC).
 * By adding 330 minutes to UTC epoch milliseconds, we can read UTC methods (`getUTCFullYear`,
 * `getUTCDate`, etc.) to obtain the exact local day and hour in Sri Lanka.
 *
 * @param {Date|string|null} inputDate
 * @returns {{ year: number, month: number, day: number, dayOfWeek: number, hours: number, minutes: number, seconds: number } | null}
 */
function toColomboDateComponents(inputDate) {
  let d;
  if (!inputDate) {
    d = new Date();
  } else if (typeof inputDate === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(inputDate.trim())) {
    // Interpret plain YYYY-MM-DD strings explicitly at noon in Asia/Colombo (UTC+05:30)
    d = new Date(`${inputDate.trim()}T12:00:00+05:30`);
  } else {
    d = new Date(inputDate);
  }
  if (isNaN(d.getTime())) return null;

  // Add offset to get local time in Colombo
  const colomboTimeMs = d.getTime() + (COLOMBO_OFFSET_MINUTES * 60 * 1000);
  const colomboDate = new Date(colomboTimeMs);

  return {
    year: colomboDate.getUTCFullYear(),
    month: colomboDate.getUTCMonth(), // 0-indexed (0 = Jan, 11 = Dec)
    day: colomboDate.getUTCDate(),
    dayOfWeek: colomboDate.getUTCDay(), // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
    hours: colomboDate.getUTCHours(),
    minutes: colomboDate.getUTCMinutes(),
    seconds: colomboDate.getUTCSeconds()
  };
}

/**
 * Calculates the exact Colombo business week range (Monday 00:00:00.000 to Sunday 23:59:59.999)
 * for any given reference date (or null for the current week).
 *
 * How the math works:
 * 1. JavaScript's `dayOfWeek`: Sunday = 0, Monday = 1, Tuesday = 2, ..., Saturday = 6.
 * 2. In Sri Lankan business operations, Monday is day 0 of the work week.
 * 3. If today is Sunday (0), it has been 6 days since Monday.
 *    Otherwise, it has been (dayOfWeek - 1) days since Monday.
 * 4. We subtract those days to find Monday 00:00:00, and add 6 days to find Sunday 23:59:59.999.
 *
 * @param {Date|string|null} referenceDate
 * @returns {Object} Week boundaries and formatted display labels
 */
function getColomboWeekRange(referenceDate) {
  const comp = toColomboDateComponents(referenceDate) || toColomboDateComponents(new Date());

  // Convert JS Sunday-first day (0=Sun) to Monday-first (0=Mon, 6=Sun)
  const colomboDay = comp.dayOfWeek;
  const daysSinceMonday = colomboDay === 0 ? 6 : (colomboDay - 1);

  // Compute Monday in Colombo
  const mondayMs = Date.UTC(comp.year, comp.month, comp.day - daysSinceMonday, 0, 0, 0, 0) - (COLOMBO_OFFSET_MINUTES * 60 * 1000);
  const sundayMs = Date.UTC(comp.year, comp.month, comp.day - daysSinceMonday + 6, 23, 59, 59, 999) - (COLOMBO_OFFSET_MINUTES * 60 * 1000);

  const startOfWeek = new Date(mondayMs);
  const endOfWeek = new Date(sundayMs);

  const monComp = toColomboDateComponents(startOfWeek);
  const sunComp = toColomboDateComponents(endOfWeek);

  const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const formattedMonday = `${String(monComp.day).padStart(2, '0')} ${monthNames[monComp.month]} ${monComp.year}`;
  const formattedSunday = `${String(sunComp.day).padStart(2, '0')} ${monthNames[sunComp.month]} ${sunComp.year}`;

  const weekNumber = getColomboWeekNumber(startOfWeek);
  const weekLabel = `Week ${weekNumber} (${formattedMonday} – ${formattedSunday})`;

  return {
    startOfWeek,
    endOfWeek,
    startIso: startOfWeek.toISOString(),
    endIso: endOfWeek.toISOString(),
    startDateStr: `${monComp.year}-${String(monComp.month + 1).padStart(2, '0')}-${String(monComp.day).padStart(2, '0')}`,
    endDateStr: `${sunComp.year}-${String(sunComp.month + 1).padStart(2, '0')}-${String(sunComp.day).padStart(2, '0')}`,
    formattedMonday,
    formattedSunday,
    formattedRange: `${formattedMonday} – ${formattedSunday}`,
    weekNumber,
    weekLabel
  };
}

/**
 * ISO-8601 week number calculation in Asia/Colombo
 */
function getColomboWeekNumber(date) {
  const comp = toColomboDateComponents(date);
  const target = new Date(Date.UTC(comp.year, comp.month, comp.day));
  const dayNr = (target.getUTCDay() + 6) % 7;
  target.setUTCDate(target.getUTCDate() - dayNr + 3);
  const firstThursday = target.valueOf();
  target.setUTCMonth(0, 1);
  if (target.getUTCDay() !== 4) {
    target.setUTCMonth(0, 1 + ((4 - target.getUTCDay()) + 7) % 7);
  }
  return 1 + Math.ceil((firstThursday - target) / 604800000);
}

/**
 * Convert currency amount to exact integer cents (avoids IEEE-754 floating-point drift)
 */
function toCents(num) {
  if (num === null || num === undefined || isNaN(num)) return 0;
  const n = Number(num);
  if (!isFinite(n)) return 0;
  const sign = n < 0 ? -1 : 1;
  return sign * Math.round((Math.abs(n) + 1e-9) * 100);
}

/**
 * Currency rounding helper (safe 2 decimal places for LKR)
 */
function roundLKR(num) {
  return toCents(num) / 100;
}

/**
 * Resolve authoritative agreed order price without mutating real prices.
 * Prefers positive `agreedTotal`, falling back to `totalAmount`.
 */
function getEffectiveAgreedPrice(order) {
  if (!order) return 0;
  const hasExplicitAgreed =
    order.agreedTotal !== null &&
    order.agreedTotal !== undefined &&
    Number(order.agreedTotal) > 0;
  const raw = hasExplicitAgreed ? Number(order.agreedTotal) : Number(order.totalAmount || 0);
  return roundLKR(Math.max(0, raw));
}

/**
 * Split an agreed order price into 50% Office, 25% Cutting, 25% Stitching.
 * Guaranteed to sum to 100% of `agreedPrice` down to the exact cent.
 */
function splitAgreedOrderPrice(agreedPrice) {
  const totalCents = Math.max(0, toCents(agreedPrice));
  if (totalCents <= 0) {
    return {
      agreedPrice: 0,
      officeAllocation: 0,
      cuttingAllocation: 0,
      stitchingAllocation: 0
    };
  }
  const cuttingCents = Math.round(totalCents * 0.25);
  const stitchingCents = Math.round(totalCents * 0.25);
  const officeCents = totalCents - cuttingCents - stitchingCents;

  return {
    agreedPrice: totalCents / 100,
    officeAllocation: officeCents / 100,
    cuttingAllocation: cuttingCents / 100,
    stitchingAllocation: stitchingCents / 100
  };
}

/**
 * Check if order price is valid and eligible for salary allocation.
 * Safely skips unpriced (<= 0), pending-approval, cancelled, rejected, or declined orders,
 * while supporting both explicit quotes and in-store shop orders priced at creation.
 */
function isOrderPriceApproved(order) {
  if (!order) return false;

  const total = getEffectiveAgreedPrice(order);
  if (total <= 0) return false;

  // Exclude unapproved, cancelled, rejected, or price-revision/declined orders
  if ([
    'PENDING_APPROVAL',
    'REJECTED',
    'CANCELLED',
    'CHANGES_REQUIRED',
    'PRICE_DECLINED',
    'PRICE_REVISION_REQUIRED'
  ].includes(order.status)) {
    return false;
  }

  // Exclude orders whose price quote was declined or sent back for revision
  if ([
    'DECLINED',
    'PRICE_DECLINED',
    'REVISION_REQUESTED',
    'PRICE_REVISION_REQUIRED'
  ].includes(order.priceStatus)) {
    return false;
  }

  return true;
}

/**
 * Calculate verified customer payment from authoritative records.
 * Partial customer payments NEVER satisfy full settlement (strict cent comparison).
 */
function calculateCustomerPayments(order) {
  if (!order) {
    return {
      agreedPrice: 0,
      totalPaid: 0,
      pendingVerificationAmount: 0,
      balanceDue: 0,
      isFullyPaid: false,
      settlementStatus: 'Unpaid'
    };
  }

  const agreedPrice = getEffectiveAgreedPrice(order);
  const agreedCents = toCents(agreedPrice);

  let verifiedCents = 0;
  let pendingCents = 0;

  if (Array.isArray(order.payments) && order.payments.length > 0) {
    for (const p of order.payments) {
      const amtCents = Math.max(0, toCents(p.amount || 0));
      if (!p.status || p.status === 'VERIFIED') {
        verifiedCents += amtCents;
      } else if (p.status === 'PENDING_VERIFICATION') {
        pendingCents += amtCents;
      }
      // REJECTED payment slips are never counted
    }
  } else if (Number(order.advancePayment) > 0) {
    verifiedCents = Math.max(0, toCents(order.advancePayment));
  }

  const balanceCents = Math.max(0, agreedCents - verifiedCents);
  const isFullyPaid = agreedCents > 0 && verifiedCents >= agreedCents;

  let settlementStatus = 'Unpaid';
  if (isFullyPaid) {
    settlementStatus = 'Fully Settled';
  } else if (verifiedCents > 0) {
    settlementStatus = 'Partially Paid';
  } else if (pendingCents > 0) {
    settlementStatus = 'Pending Verification';
  }

  return {
    agreedPrice,
    totalPaid: verifiedCents / 100,
    pendingVerificationAmount: pendingCents / 100,
    balanceDue: balanceCents / 100,
    isFullyPaid,
    settlementStatus
  };
}

/**
 * Extract work completion details for Cutting and Stitching independently.
 * Primary source of truth: granular OrderTask records when any OrderTask exists on the order.
 * Legacy fallback (ONLY when the order has zero OrderTask records): Order.assignedTailorId + workflow stage.
 */
function extractWorkCompletion(order, workType) {
  const isCutting = workType === 'CUTTING';
  const targetTaskType = isCutting ? 'CUTTING' : 'STITCHING';

  // 1. Granular OrderTask workflow (authoritative whenever tasks have been configured for the order)
  const activeOrderTasks = Array.isArray(order.tasks)
    ? order.tasks.filter(t => t.status !== 'CANCELLED')
    : [];

  if (activeOrderTasks.length > 0) {
    const task = activeOrderTasks.find(t => t.taskType === targetTaskType);
    if (task) {
      const hasTailor = Boolean(task.assignedTailorId);
      const isCompleted = hasTailor && task.status === 'COMPLETED';
      return {
        assignedTailorId: task.assignedTailorId || null,
        tailorName: task.assignedTailor?.name || null,
        tailorEmail: task.assignedTailor?.email || null,
        isCompleted,
        completedAt: isCompleted ? (task.completedAt || task.updatedAt || order.updatedAt) : null,
        taskStatus: !hasTailor ? 'UNASSIGNED' : task.status,
        hasTaskRecord: true,
        taskId: task.id
      };
    }

    // Sibling tasks exist on this order, but this specific workType (Cutting or Stitching)
    // has not been assigned yet — keep it strictly independent & unassigned!
    return {
      assignedTailorId: null,
      tailorName: null,
      tailorEmail: null,
      isCompleted: false,
      completedAt: null,
      taskStatus: 'UNASSIGNED',
      hasTaskRecord: false,
      taskId: null
    };
  }

  // 2. Legacy Fallback (ONLY for orders with zero OrderTask records): Order.assignedTailorId + workflow stages
  const primaryTailorId = order.assignedTailorId || null;
  const tailorName = order.assignedTailor?.name || null;
  const tailorEmail = order.assignedTailor?.email || null;

  if (!primaryTailorId) {
    return {
      assignedTailorId: null,
      tailorName: null,
      tailorEmail: null,
      isCompleted: false,
      completedAt: null,
      taskStatus: 'UNASSIGNED',
      hasTaskRecord: false,
      taskId: null
    };
  }

  // Stages that indicate cutting completion
  const cuttingCompletedStages = [
    'STITCHING', 'AARI_EMBROIDERY', 'QUALITY_CHECK',
    'ALTERATION', 'FITTING_ALTERATION', 'FINISHING',
    'READY', 'DELIVERED', 'COMPLETED'
  ];

  // Stages that indicate stitching completion
  const stitchingCompletedStages = [
    'QUALITY_CHECK', 'ALTERATION', 'FITTING_ALTERATION',
    'FINISHING', 'READY', 'DELIVERED', 'COMPLETED'
  ];

  const completedStages = isCutting ? cuttingCompletedStages : stitchingCompletedStages;
  const isOrderCancelled = ['CANCELLED', 'REJECTED'].includes(order.status);
  const isCompleted = !isOrderCancelled && completedStages.includes(order.status);

  // Find completion date from ProductionHistory if available
  let completedDate = null;
  if (isCompleted) {
    if (Array.isArray(order.productionHistory) && order.productionHistory.length > 0) {
      const hist = order.productionHistory.find(h => h.stage === targetTaskType && h.completedAt);
      if (hist && hist.completedAt) {
        completedDate = new Date(hist.completedAt);
      }
    }
    if (!completedDate) {
      completedDate = order.completedAt ? new Date(order.completedAt) : new Date(order.updatedAt || order.createdAt);
    }
  }

  return {
    assignedTailorId: primaryTailorId,
    tailorName,
    tailorEmail,
    isCompleted,
    completedAt: completedDate,
    taskStatus: isCompleted ? 'COMPLETED' : (order.status === targetTaskType ? 'IN_PROGRESS' : 'ASSIGNED'),
    hasTaskRecord: false,
    taskId: null
  };
}

/**
 * Map internal salary status code to canonical display label:
 * WORK PENDING | ON HOLD | PAYABLE | PAID
 */
function getSalaryStatusLabel(status) {
  switch (status) {
    case 'PAID':
      return 'PAID';
    case 'PAYABLE':
      return 'PAYABLE';
    case 'ON_HOLD':
    case 'ON_HOLD_CUSTOMER_PAYMENT':
      return 'ON HOLD';
    case 'WORK_PENDING':
    default:
      return 'WORK PENDING';
  }
}

/**
 * Normalize status filter query parameter to internal status code(s)
 */
function matchesSalaryStatusFilter(allocationStatus, filterValue) {
  if (!filterValue || filterValue === 'ALL') return true;
  const norm = String(filterValue).trim().toUpperCase().replace(/\s+/g, '_');
  if (norm === 'ON_HOLD' || norm === 'ON_HOLD_CUSTOMER_PAYMENT') {
    return allocationStatus === 'ON_HOLD_CUSTOMER_PAYMENT' || allocationStatus === 'ON_HOLD';
  }
  if (norm === 'WORK_PENDING') {
    return allocationStatus === 'WORK_PENDING';
  }
  return allocationStatus === norm;
}

/**
 * Generate all salary allocations for an order:
 * - Office allocation: 50%
 * - Cutting tailor allocation: 25%
 * - Stitching tailor allocation: 25%
 *
 * @param {Object} order - Order with garmentDetails, customer, tasks, payments, assignedTailor, productionHistory
 * @param {Array} paidSalaryRecords - Array of existing TailorSalaryPayment records
 */
function calculateOrderSalaryAllocations(order, paidSalaryRecords = []) {
  if (!order) return [];

  // Check price validity
  if (!isOrderPriceApproved(order)) {
    return []; // No salary calculated for unpriced, pending, or declined orders
  }

  const {
    agreedPrice,
    totalPaid,
    pendingVerificationAmount,
    balanceDue,
    isFullyPaid,
    settlementStatus
  } = calculateCustomerPayments(order);
  if (agreedPrice <= 0) return [];

  // Exact 100% allocation split (50% Office + 25% Cutting + 25% Stitching = 100%)
  const {
    officeAllocation,
    cuttingAllocation,
    stitchingAllocation
  } = splitAgreedOrderPrice(agreedPrice);

  const allocations = [];

  // --- Two Separate Work Allocations per Order: CUTTING (25%) and STITCHING (25%) ---
  const workTypes = [
    { type: 'CUTTING', name: 'Cutting', percent: 25.0, amount: cuttingAllocation },
    { type: 'STITCHING', name: 'Stitching', percent: 25.0, amount: stitchingAllocation }
  ];

  for (const wt of workTypes) {
    const workInfo = extractWorkCompletion(order, wt.type);

    // Match recorded salary disbursement for this specific (orderId, workType) allocation
    const existingPayment = paidSalaryRecords.find(p =>
      Number(p.orderId) === Number(order.id) &&
      p.workType === wt.type
    );

    const tailorId = workInfo.assignedTailorId || (existingPayment ? Number(existingPayment.tailorId) : null);
    const resolvedTailorName =
      workInfo.tailorName ||
      existingPayment?.tailorName ||
      (tailorId ? `Tailor #${tailorId}` : 'Unassigned');
    const resolvedTailorEmail = workInfo.tailorEmail || existingPayment?.tailorEmail || null;
    const isWorkCompleted = existingPayment ? true : Boolean(workInfo.isCompleted);
    const workCompletedAt = workInfo.completedAt || (existingPayment ? existingPayment.paymentDate : null);

    let workStatusLabel = 'Unassigned';
    if (isWorkCompleted) {
      workStatusLabel = 'Completed';
    } else if (!tailorId) {
      workStatusLabel = 'Unassigned';
    } else if (workInfo.taskStatus === 'IN_PROGRESS') {
      workStatusLabel = 'In Progress';
    } else {
      workStatusLabel = 'Pending';
    }

    let status = 'WORK_PENDING';
    if (existingPayment) {
      status = 'PAID';
    } else if (isWorkCompleted && isFullyPaid) {
      status = 'PAYABLE';
    } else if (isWorkCompleted && !isFullyPaid) {
      status = 'ON_HOLD_CUSTOMER_PAYMENT';
    } else {
      status = 'WORK_PENDING';
    }

    allocations.push({
      allocationKey: `${order.id}-${wt.type}-${tailorId || 'unassigned'}`,
      orderId: order.id,
      orderNumber: order.orderNumber,
      orderDate: order.orderDate || order.createdAt || null,
      customerId: order.customerId,
      customerName: order.customer?.name || 'Customer',
      dressType: order.garmentDetails?.dressType || 'Garment',
      quantity: order.garmentDetails?.quantity || 1,
      branchId: order.branchId,
      branchName: order.branch?.name || 'JB Group (Main)',
      agreedPrice,
      officeAllocation,
      workType: wt.type,
      workTypeName: wt.name,
      allocationPercent: wt.percent,
      allocatedAmount: wt.amount,
      tailorId,
      tailorName: resolvedTailorName,
      tailorEmail: resolvedTailorEmail,
      taskId: workInfo.taskId,
      taskStatus: isWorkCompleted ? 'COMPLETED' : workInfo.taskStatus,
      workStatusLabel,
      isWorkCompleted,
      workCompletedAt,
      customerTotalPaid: totalPaid,
      customerPendingVerification: pendingVerificationAmount,
      customerBalanceDue: balanceDue,
      isCustomerFullyPaid: isFullyPaid,
      customerPaymentStatus: isFullyPaid
        ? 'Paid in Full'
        : (totalPaid > 0 ? 'Partially Paid' : settlementStatus),
      status, // 'WORK_PENDING', 'ON_HOLD_CUSTOMER_PAYMENT', 'PAYABLE', 'PAID'
      statusLabel: getSalaryStatusLabel(status), // 'WORK PENDING', 'ON HOLD', 'PAYABLE', 'PAID'
      paymentRecord: existingPayment ? {
        id: existingPayment.id,
        tailorId: existingPayment.tailorId,
        amountPaid: roundLKR(existingPayment.amountPaid),
        paymentDate: existingPayment.paymentDate,
        paymentMethod: existingPayment.paymentMethod,
        referenceNo: existingPayment.referenceNo,
        notes: existingPayment.notes,
        recordedByName: existingPayment.recordedByName
      } : null
    });
  }

  return {
    orderId: order.id,
    orderNumber: order.orderNumber,
    agreedPrice,
    officeAllocation,
    cuttingAllocation,
    stitchingAllocation,
    allocations
  };
}

/**
 * Filter and compute weekly metrics across individual 25% work allocations
 * using the selected business week in Asia/Colombo timezone.
 * Never sums `agreedPrice` across work rows (no duplicate counting).
 */
function computeWeeklySalaryMetrics(allAllocations, paidRecordsInPeriod, weekRange) {
  const startMs = weekRange.startOfWeek.getTime();
  const endMs = weekRange.endOfWeek.getTime();

  let totalEarnedCents = 0;
  let totalPayableCents = 0;
  let totalHeldCents = 0;
  let totalWorkPendingCents = 0;
  let totalPaidCents = 0;
  let totalCarriedForwardCents = 0;

  const participatingTailorIds = new Set();
  const weeklyAllocationsList = [];
  const carriedForwardList = [];

  for (const alloc of allAllocations) {
    const allocCents = toCents(alloc.allocatedAmount);
    const orderTimeMs = alloc.orderDate ? new Date(alloc.orderDate).getTime() : null;
    const workCompletedMs = alloc.workCompletedAt ? new Date(alloc.workCompletedAt).getTime() : null;

    // Exclude orders created strictly after the end of the selected historical week
    if (orderTimeMs !== null && !isNaN(orderTimeMs) && orderTimeMs > endMs) {
      continue;
    }

    // 1. Total Earned (Week):
    // Assigned work completed within [startOfWeek, endOfWeek] in Asia/Colombo
    const isCompletedInWeek =
      Boolean(alloc.isWorkCompleted) &&
      workCompletedMs !== null &&
      !isNaN(workCompletedMs) &&
      workCompletedMs >= startMs &&
      workCompletedMs <= endMs;

    if (isCompletedInWeek) {
      totalEarnedCents += allocCents;
      if (alloc.tailorId) participatingTailorIds.add(Number(alloc.tailorId));
      weeklyAllocationsList.push({
        ...alloc,
        isEarnedInSelectedWeek: true
      });
    }

    // 2. Carried Forward:
    // Work completed BEFORE startOfWeek, customer fully settled, and still unpaid (PAYABLE)
    const isCompletedBeforeWeek =
      Boolean(alloc.isWorkCompleted) &&
      workCompletedMs !== null &&
      !isNaN(workCompletedMs) &&
      workCompletedMs < startMs;

    const isUnpaidCarryForward =
      isCompletedBeforeWeek &&
      Boolean(alloc.isCustomerFullyPaid) &&
      alloc.status === 'PAYABLE';

    if (isUnpaidCarryForward) {
      totalCarriedForwardCents += allocCents;
      if (alloc.tailorId) participatingTailorIds.add(Number(alloc.tailorId));
      carriedForwardList.push({
        ...alloc,
        isCarriedForward: true
      });
    }

    // 3. Status buckets (Payable, Held on Customer Payment, Work Pending)
    const completedOnOrBeforeWeekEnd =
      workCompletedMs === null || isNaN(workCompletedMs) || workCompletedMs <= endMs;

    if (alloc.status === 'PAYABLE' && completedOnOrBeforeWeekEnd) {
      totalPayableCents += allocCents;
      if (alloc.tailorId) participatingTailorIds.add(Number(alloc.tailorId));
    } else if (
      (alloc.status === 'ON_HOLD_CUSTOMER_PAYMENT' || alloc.status === 'ON_HOLD') &&
      completedOnOrBeforeWeekEnd
    ) {
      totalHeldCents += allocCents;
      if (alloc.tailorId) participatingTailorIds.add(Number(alloc.tailorId));
    } else if (alloc.status === 'WORK_PENDING') {
      totalWorkPendingCents += allocCents;
      if (alloc.tailorId) participatingTailorIds.add(Number(alloc.tailorId));
    }
  }

  // 4. Salary Paid (Week): actual disbursements recorded within [startOfWeek, endOfWeek]
  for (const pr of paidRecordsInPeriod || []) {
    const pDateMs = pr.paymentDate ? new Date(pr.paymentDate).getTime() : NaN;
    if (!isNaN(pDateMs) && pDateMs >= startMs && pDateMs <= endMs) {
      totalPaidCents += toCents(pr.amountPaid || 0);
      if (pr.tailorId) participatingTailorIds.add(Number(pr.tailorId));
    }
  }

  return {
    weekRange,
    summary: {
      totalEarnedInWeek: totalEarnedCents / 100,
      totalPayable: totalPayableCents / 100,
      totalHeldOnCustomerPayment: totalHeldCents / 100,
      totalWorkPending: totalWorkPendingCents / 100,
      totalPaidInWeek: totalPaidCents / 100,
      totalCarriedForward: totalCarriedForwardCents / 100,
      participatingTailorsCount: participatingTailorIds.size
    },
    weeklyAllocationsList,
    carriedForwardList
  };
}

module.exports = {
  COLOMBO_OFFSET_MINUTES,
  getColomboWeekRange,
  getColomboWeekNumber,
  toColomboDateComponents,
  toCents,
  roundLKR,
  getEffectiveAgreedPrice,
  splitAgreedOrderPrice,
  isOrderPriceApproved,
  calculateCustomerPayments,
  extractWorkCompletion,
  getSalaryStatusLabel,
  matchesSalaryStatusFilter,
  calculateOrderSalaryAllocations,
  computeWeeklySalaryMetrics
};
